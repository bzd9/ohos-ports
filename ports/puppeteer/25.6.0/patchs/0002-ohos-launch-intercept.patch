From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 +0800
From: ohos-ports
Date: Fri, 15 Aug 2026 00:00:00 +0800
Subject: [PATCH 2/4] BrowserLauncher: intercept launch() on openharmony

On openharmony, delegate puppeteer.launch() to launchViaHdc() which
starts the browser via aa start and connects via CDP WebSocket.
---
 .../puppeteer-core/src/node/BrowserLauncher.ts        | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/packages/puppeteer-core/src/node/BrowserLauncher.ts b/packages/puppeteer-core/src/node/BrowserLauncher.ts
--- a/packages/puppeteer-core/src/node/BrowserLauncher.ts
+++ b/packages/puppeteer-core/src/node/BrowserLauncher.ts
@@ -XXX,XX +XXX,XX @@
   override async launch(options: LaunchOptions = {}): Promise<Browser> {
+    // OHOS: On openharmony, delegate to HDC launch
+    if (process.platform === 'openharmony') {
+      const { launchViaHdc } = await import('./HdcLauncher.js');
+      return await launchViaHdc(this, options);
+    }
     options.logger ??= this.#logger;
     // ... original launch logic
