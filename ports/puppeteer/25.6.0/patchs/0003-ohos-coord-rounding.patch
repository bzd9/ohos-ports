From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 +0800
From: ohos-ports
Date: Fri, 15 Aug 2026 00:00:00 +0800
Subject: [PATCH 3/4] ElementHandle: round sub-pixel coordinates

HarmonyOS GPU rendering returns sub-pixel float coordinates.
Round boundingBox() and clickablePoint() return values.
---
 .../puppeteer-core/src/api/ElementHandle.ts       | 24 ++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/packages/puppeteer-core/src/api/ElementHandle.ts b/packages/puppeteer-core/src/api/ElementHandle.ts
--- a/packages/puppeteer-core/src/api/ElementHandle.ts
+++ b/packages/puppeteer-core/src/api/ElementHandle.ts
@@ -XXX,XX +XXX,XX @@ export abstract class ElementHandle {
   override async boundingBox(): Promise<BoundingBox | null> {
     // ... existing logic ...
+    // OHOS: Round sub-pixel coordinates
+    if (process.platform === 'openharmony') {
+      return {
+        x: Math.round(result.x),
+        y: Math.round(result.y),
+        width: Math.round(result.width),
+        height: Math.round(result.height),
+      };
+    }
     return result;
   }

   override async clickablePoint(offset?: Offset): Promise<Point> {
     // ... existing logic ...
+    // OHOS: Round sub-pixel coordinates
+    if (process.platform === 'openharmony') {
+      return {
+        x: Math.round(result.x),
+        y: Math.round(result.y),
+      };
+    }
     return result;
   }
